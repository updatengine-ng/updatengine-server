{
  "name": "updatengine-server",
  "version": "8.0.0",
  "description": "Modern UpdatEngine Server interface",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "concurrently \"npm run watch:css\" \"npm run watch:js\"",
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i ./static_modern/src/input.css -o ./updatengine/files/modern-ui/modern-ui.css --minify",
    "watch:css": "tailwindcss -i ./static_modern/src/input.css -o ./updatengine/files/modern-ui/modern-ui.css --watch",
    "build:js": "esbuild ./static_modern/src/main.js --bundle --minify --sourcemap --outfile=./updatengine/files/modern-ui/modern-ui.js",
    "watch:js": "esbuild ./static_modern/src/main.js --bundle --sourcemap --watch --outfile=./updatengine/files/modern-ui/modern-ui.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint static_modern/src",
    "format": "prettier --write \"static_modern/src/**/*.{js,css}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/updatengine-ng/updatengine-server.git"
  },
  "keywords": [
    "updatengine",
    "system-management",
    "deployment",
    "inventory",
    "rmm",
    "modern-ui"
  ],
  "author": "updatengine",
  "license": "GPL-2.0",
  "bugs": {
    "url": "https://github.com/updatengine-ng/updatengine-server/issues"
  },
  "homepage": "https://github.com/updatengine-ng/updatengine-server#readme",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "alpinejs": "^3.15.12",
    "chart.js": "^4.5.1",
    "concurrently": "^10.0.4",
    "esbuild": "^0.28.1",
    "htmx.org": "^2.0.10",
    "jest": "^30.4.2",
    "tailwindcss": "^4.3.3"
  }
}

